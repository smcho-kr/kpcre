+ /* Consume the whole clause so regex remains an ordinary identifier elsewhere. */
+regex[ \t]+\"([^"\\]|\\(.|\n))*\" {
+				char *p, *out, *pattern;
+
+				if (memchr(yytext, 0, yyleng))
+					return JUNK;
+				pattern = xmalloc(yyleng);
+				p = strchr(yytext, '"') + 1;
+				for (out = pattern; p < yytext + yyleng - 1; p++) {
+					if (*p == '\\' && (p[1] == '\\' || p[1] == '"'))
+						p++;
+					*out++ = *p;
+				}
+				*out = 0;
+				yylval->string = pattern;
+				return REGEX;
+			}
+
 {quotedstring}		{
 				yytext[yyleng - 1] = '\0';
 				yylval->string = xstrdup(yytext + 1);
diff --git a/src/statement.c b/src/statement.c
index d0993dd..c0155f0 100644
