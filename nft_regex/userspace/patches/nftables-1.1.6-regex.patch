 	return stmt_alloc(loc, &meter_stmt_ops);
 }
 
+static void regex_stmt_print(const struct stmt *stmt, struct output_ctx *octx)
+{
+	const unsigned char *p = (const void *)stmt->regex.pattern;
+
+	nft_print(octx, "regex \"");
+	for (; *p; p++) {
+		if (*p == '\\' || *p == '"')
+			nft_print(octx, "\\");
+		nft_print(octx, "%c", *p);
+	}
+	nft_print(octx, "\"");
+}
+
+static void regex_stmt_destroy(struct stmt *stmt)
+{
+	free_const(stmt->regex.pattern);
+}
+
+static const struct stmt_ops regex_stmt_ops = {
+	.type = STMT_REGEX,
+	.name = "regex",
+	.print = regex_stmt_print,
+	.json = regex_stmt_json,
+	.destroy = regex_stmt_destroy,
+};
+
+struct stmt *regex_stmt_alloc(const struct location *loc, const char *pattern)
+{
+	struct stmt *stmt = stmt_alloc(loc, &regex_stmt_ops);
+
+	stmt->regex.pattern = xstrdup(pattern);
+	return stmt;
+}
