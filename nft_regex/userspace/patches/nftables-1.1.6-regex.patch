+static struct stmt *json_parse_regex_stmt(struct json_ctx *ctx,
+					  const char *key, json_t *value)
+{
+	json_t *pattern;
+
+	if (json_unpack_err(ctx, value, "{s:o}", "pattern", &pattern))
+		return NULL;
+	if (!json_is_string(pattern) ||
+	    strlen(json_string_value(pattern)) != json_string_length(pattern)) {
+		json_error(ctx, "Regex pattern must be a string without embedded NULs");
+		return NULL;
+	}
+	return regex_stmt_alloc(int_loc, json_string_value(pattern));
+}
