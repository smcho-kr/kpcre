diff --git a/src/expr/regex.c b/src/expr/regex.c
new file mode 100644
index 0000000..6db5167
--- /dev/null
+++ b/src/expr/regex.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <linux/netfilter/nft_regex.h>
+#include "internal.h"
+#include <libmnl/libmnl.h>
+#include <libnftnl/expr.h>
+
+struct nftnl_expr_regex {
+	char pattern[NFT_REGEX_PATTERN_MAX + 1];
+};
+
+static int nftnl_expr_regex_set(struct nftnl_expr *e, uint16_t type,
+				const void *data, uint32_t len)
+{
+	struct nftnl_expr_regex *regex = nftnl_expr_data(e);
+
+	if (type != NFTNL_EXPR_REGEX_PATTERN || len < 2 ||
+	    len > sizeof(regex->pattern) || ((const char *)data)[len - 1] ||
+	    memchr(data, 0, len - 1)) {
+		errno = EINVAL;
+		return -1;
+	}
+	memcpy(regex->pattern, data, len);
+	return 0;
+}
+
+static const void *nftnl_expr_regex_get(const struct nftnl_expr *e, uint16_t type,
+				      uint32_t *len)
+{
+	struct nftnl_expr_regex *regex = nftnl_expr_data(e);
+
+	if (type != NFTNL_EXPR_REGEX_PATTERN)
+		return NULL;
+	*len = strlen(regex->pattern) + 1;
+	return regex->pattern;
+}
+
+static int nftnl_expr_regex_cb(const struct nlattr *attr, void *data)
+{
+	const struct nlattr **tb = data;
+	unsigned int len;
+
+	if (mnl_attr_get_type(attr) != NFTA_REGEX_PATTERN)
+		return MNL_CB_OK;
+	len = mnl_attr_get_payload_len(attr);
+	if (mnl_attr_validate(attr, MNL_TYPE_NUL_STRING) < 0 || len < 2 ||
+	    len > NFT_REGEX_PATTERN_MAX + 1 ||
+	    memchr(mnl_attr_get_payload(attr), 0, len - 1)) {
+		errno = EINVAL;
+		return MNL_CB_ERROR;
+	}
+	tb[NFTA_REGEX_PATTERN] = attr;
+	return MNL_CB_OK;
+}
+
+static int nftnl_expr_regex_parse(struct nftnl_expr *e, struct nlattr *attr)
+{
+	const struct nlattr *tb[NFTA_REGEX_MAX + 1] = {};
+
+	if (mnl_attr_parse_nested(attr, nftnl_expr_regex_cb, tb) < 0)
+		return -1;
+	if (!tb[NFTA_REGEX_PATTERN]) {
+		errno = EINVAL;
+		return -1;
+	}
+	return nftnl_expr_set(e, NFTNL_EXPR_REGEX_PATTERN,
+		mnl_attr_get_payload(tb[NFTA_REGEX_PATTERN]),
+		mnl_attr_get_payload_len(tb[NFTA_REGEX_PATTERN]));
+}
+
+static void nftnl_expr_regex_build(struct nlmsghdr *nlh, const struct nftnl_expr *e)
+{
+	struct nftnl_expr_regex *regex = nftnl_expr_data(e);
+
+	if (e->flags & (1 << NFTNL_EXPR_REGEX_PATTERN))
+		mnl_attr_put_strz(nlh, NFTA_REGEX_PATTERN, regex->pattern);
+}
+
+static int nftnl_expr_regex_output(char *buf, size_t len, uint32_t flags,
+				  const struct nftnl_expr *e)
+{
+	struct nftnl_expr_regex *regex = nftnl_expr_data(e);
+
+	return snprintf(buf, len, "pattern %s ", regex->pattern);
+}
+
+static struct attr_policy regex_policy[__NFTNL_EXPR_REGEX_MAX] = {
+	[NFTNL_EXPR_REGEX_PATTERN] = { .maxlen = NFT_REGEX_PATTERN_MAX + 1 },
+};
+
+struct expr_ops expr_ops_regex = {
+	.name = "regex",
+	.alloc_len = sizeof(struct nftnl_expr_regex),
+	.nftnl_max_attr = __NFTNL_EXPR_REGEX_MAX - 1,
+	.attr_policy = regex_policy,
+	.set = nftnl_expr_regex_set,
+	.get = nftnl_expr_regex_get,
+	.parse = nftnl_expr_regex_parse,
+	.build = nftnl_expr_regex_build,
+	.output = nftnl_expr_regex_output,
+};
